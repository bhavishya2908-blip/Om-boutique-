<script>
(function(){
var rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
function burst(x,y){var cols=['#d93f5c','#ff7a93','#f2b8c4','#4a7c6f','#e8c25b','#2a3175'];
for(var n=0;n<36;n++){var p=document.createElement('i');p.className='conf';p.style.left=x+'px';p.style.top=y+'px';p.style.background=cols[n%cols.length];document.body.appendChild(p);
var a=Math.random()*Math.PI*2,d=80+Math.random()*180;
p.animate([{transform:'translate(0,0) rotate(0)',opacity:1},{transform:'translate('+Math.cos(a)*d+'px,'+(Math.sin(a)*d+120)+'px) rotate('+Math.random()*720+'deg)',opacity:0}],{duration:900+Math.random()*600,easing:'cubic-bezier(.2,.7,.3,1)'}).onfinish=(function(el){return function(){el.remove()}})(p);}}
if(rm)return;
var h=document.querySelector('.hero h1'),t=h.textContent;
h.setAttribute('aria-label',t);h.textContent='';
var i=0;t.split(' ').forEach(function(w){var ws=document.createElement('span');ws.className='w';ws.setAttribute('aria-hidden','true');
w.split('').forEach(function(c){var s=document.createElement('span');s.className='ch';s.textContent=c;s.style.animationDelay=(i++*55)+'ms';ws.appendChild(s)});
h.appendChild(ws);h.appendChild(document.createTextNode(' '))});
document.documentElement.classList.add('js');
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15});
document.querySelectorAll('.card,.col,.story>*,.visit').forEach(function(el,k){el.classList.add('rv');el.style.transitionDelay=(k%4)*90+'ms';io.observe(el)});
document.querySelectorAll('.btn').forEach(function(b){b.addEventListener('click',function(e){var r=b.getBoundingClientRect();burst(e.clientX||r.left+r.width/2,e.clientY||r.top+r.height/2)})});
})();
</script>
<script>
(function(){
var nav=document.getElementById('mainnav'),links=[].slice.call(nav.querySelectorAll('a')),hd=document.querySelector('header'),btn=document.querySelector('.menu'),pr=document.querySelector('.progress'),ind=document.createElement('span'),cur=null,tick=false;
ind.className='ind';ind.setAttribute('aria-hidden','true');nav.insertBefore(ind,nav.firstChild);
function mv(a){links.forEach(function(l){l.classList.toggle('under',l===a)});if(!a){ind.style.opacity=0;return}ind.style.opacity=1;ind.style.width=a.offsetWidth+'px';ind.style.transform='translateX('+a.offsetLeft+'px)'}
function setOn(a){cur=a;links.forEach(function(l){l.classList.toggle('on',l===a);if(l===a)l.setAttribute('aria-current','true');else l.removeAttribute('aria-current')});mv(a)}
links.forEach(function(a){['mouseenter','focus'].forEach(function(ev){a.addEventListener(ev,function(){mv(a)})});['mouseleave','blur'].forEach(function(ev){a.addEventListener(ev,function(){mv(cur)})});a.addEventListener('click',close)});
function close(){nav.classList.remove('open');btn.setAttribute('aria-expanded','false')}
btn.addEventListener('click',function(e){e.stopPropagation();var o=nav.classList.toggle('open');btn.setAttribute('aria-expanded',o)});
document.addEventListener('click',function(e){if(!nav.contains(e.target))close()});
document.addEventListener('keydown',function(e){if(e.key==='Escape')close()});
function update(){tick=false;var y=window.scrollY,max=document.documentElement.scrollHeight-innerHeight;pr.style.transform='scaleX('+(max>0?Math.min(y/max,1):0)+')';hd.classList.toggle('sc',y>20);
var a=null;if(location.hash==='#measure'||location.hash==='#login')a=links.filter(function(l){return l.getAttribute('href')===location.hash})[0]||null;else{a=links[0];links.forEach(function(l){var h=l.getAttribute('href'),s=document.querySelector(h);if(y>200&&h!=='#measure'&&h!=='#login'&&h!=='#top'&&s&&s.getBoundingClientRect().top<innerHeight*.45)a=l})}
if(a!==cur)setOn(a)}
addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(update)}},{passive:true});
addEventListener('resize',function(){mv(cur)});
update();
})();
</script>
<script>
(function(){
var main=document.getElementById('top'),page=document.getElementById('measure'),TO='bhavishya2908@gmail.com',st=document.getElementById('m-status');
function route(){var h=location.hash;document.querySelector('.acct').classList.toggle('on',h==='#login');
if(h==='#measure'||h==='#login'){main.hidden=true;page.hidden=h!=='#measure';document.getElementById('login').hidden=h!=='#login';scrollTo(0,0);document.title=(h==='#login'?'Login':'Send measurements')+' – Om Boutique'}
else{var was=main.hidden;main.hidden=false;page.hidden=true;document.getElementById('login').hidden=true;document.title='Om Boutique';
if(was){var el=null;try{el=h.length>1?document.querySelector(h):null}catch(e){}if(el)el.scrollIntoView();else scrollTo(0,0)}}
dispatchEvent(new Event('scroll'))}
addEventListener('hashchange',route);route();
function build(){var name=document.getElementById('m-name').value.trim(),phone=document.getElementById('m-phone').value.trim(),item=document.getElementById('m-item').value,unit=document.getElementById('m-unit').value,notes=document.getElementById('m-notes').value.trim(),l=[];
document.querySelectorAll('[data-m]').forEach(function(i){if(i.value.trim())l.push(i.getAttribute('data-m')+': '+i.value.trim()+' '+unit)});
if(!name){st.textContent='Please enter your name first.';document.getElementById('m-name').focus();return null}
if(!l.length&&!notes){st.textContent='Add at least one measurement or a note.';document.getElementById('m1').focus();return null}
var body='Name: '+name+(phone?'\nPhone: '+phone:'')+'\nFor: '+item+'\n\nMeasurements ('+unit+')\n'+(l.join('\n')||'None given')+(notes?'\n\nNotes: '+notes:'');
return{subject:'Measurements from '+name+' ('+item+')',body:body}}
var KEY='PASTE_YOUR_WEB3FORMS_ACCESS_KEY_HERE';
document.getElementById('mform').addEventListener('submit',function(e){e.preventDefault();var m=build();if(!m)return;
var f=e.target,btn=f.querySelector('button[type=submit]');btn.disabled=true;st.textContent='Sending\u2026';
fetch('https://api.web3forms.com/submit',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({access_key:KEY,subject:m.subject,from_name:'Om Boutique',message:m.body})})
.then(function(r){return r.json()})
.then(function(d){if(!d.success)throw new Error('fail');st.textContent='Sent! We have received your measurements and will contact you soon.';f.reset()})
.catch(function(){st.textContent='Could not send. Please try again, or press Copy details and email them to '+TO+'.'})
.then(function(){btn.disabled=false})});
document.getElementById('m-copy').addEventListener('click',function(){var m=build();if(!m)return;
var done=function(){st.textContent='Copied. Paste it into an email to '+TO+'.'},fail=function(){st.textContent='Could not copy. Select the details and send them to '+TO+'.'};
try{navigator.clipboard.writeText(m.subject+'\n\n'+m.body).then(done,fail)}catch(err){fail()}});
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script>
(function(){
var SB_URL='PASTE_YOUR_SUPABASE_PROJECT_URL',SB_KEY='PASTE_YOUR_SUPABASE_ANON_KEY';
var mode='login',user=null,$=function(i){return document.getElementById(i)},
sb=(window.supabase&&SB_URL.indexOf('https://')===0)?window.supabase.createClient(SB_URL,SB_KEY):null;
function say(t){$('l-status').textContent=t}
function nice(e){var m=(e&&e.message)||'';if(/invalid login/i.test(m))return 'Wrong email or password.';if(/already/i.test(m))return 'This email already has an account. Try logging in.';if(/not confirmed/i.test(m))return 'Please confirm your email first. Check your inbox.';return m||'Something went wrong. Please try again.'}
function render(){var su=mode==='signup',inn=!!user;
$('lform').hidden=inn;document.querySelector('.swap').hidden=inn;$('l-out').hidden=!inn;
document.querySelector('.acct').classList.toggle('in',inn);
if(inn){var meta=user.user_metadata||{};$('l-title').textContent='Hello, '+(meta.full_name||'there');$('l-sub').textContent='You are logged in as '+user.email+'.';return}
$('l-namef').hidden=!su;$('l-title').textContent=su?'Create your account':'Welcome back';
$('l-sub').textContent=su?'Join Om Boutique to save your measurements and track orders.':'Log in to see your orders and saved measurements.';
$('l-btn').textContent=su?'Create account':'Log in';$('l-q').textContent=su?'Already have an account?':'New here?';$('l-swap').textContent=su?'Log in':'Create an account';
$('l-pass').autocomplete=su?'new-password':'current-password'}
$('l-eye').addEventListener('click',function(){var p=$('l-pass'),h=p.type==='password';p.type=h?'text':'password';this.textContent=h?'Hide':'Show';this.setAttribute('aria-label',h?'Hide password':'Show password')});
$('l-swap').addEventListener('click',function(){mode=mode==='login'?'signup':'login';say('');render()});
$('l-forgot').addEventListener('click',function(e){e.preventDefault();var em=$('l-email').value.trim();
if(!sb)return say('Login is not set up yet. Add your Supabase details to the file first.');
if(!/^\S+@\S+\.\S+$/.test(em))return say('Type your email above, then press Forgot password again.');
sb.auth.resetPasswordForEmail(em,{redirectTo:location.origin+location.pathname}).then(function(r){say(r.error?nice(r.error):'Check your email for a password reset link.')})});
$('lform').addEventListener('submit',function(e){e.preventDefault();
var su=mode==='signup',name=$('l-name').value.trim(),em=$('l-email').value.trim(),pw=$('l-pass').value;
if(su&&!name){say('Please enter your name.');$('l-name').focus();return}
if(!/^\S+@\S+\.\S+$/.test(em)){say('Please enter a valid email address.');$('l-email').focus();return}
if(pw.length<6){say('Your password needs at least 6 characters.');$('l-pass').focus();return}
if(!sb){say('Login is not set up yet. Add your Supabase details to the file first.');return}
var btn=$('l-btn');btn.disabled=true;say('Please wait\u2026');
var p=su?sb.auth.signUp({email:em,password:pw,options:{data:{full_name:name}}}):sb.auth.signInWithPassword({email:em,password:pw});
p.then(function(r){if(r.error)throw r.error;
if(su&&!r.data.session){say('Account created. Check your email, press the confirm link, then log in.');mode='login';render();return}
$('lform').reset();say('')})
.catch(function(err){say(nice(err))})
.then(function(){btn.disabled=false})});
$('l-logout').addEventListener('click',function(){if(sb)sb.auth.signOut()});
if(sb){
sb.auth.getSession().then(function(r){user=r.data.session?r.data.session.user:null;render()});
sb.auth.onAuthStateChange(function(ev,session){user=session?session.user:null;render();
if(ev==='PASSWORD_RECOVERY'){setTimeout(function(){location.hash='#login';var np=prompt('Enter your new password (at least 6 characters)');if(np&&np.length>=6)sb.auth.updateUser({password:np}).then(function(r){say(r.error?nice(r.error):'Password updated.')})},0)}})
}else render();
})();
</script>
